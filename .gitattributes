# Auto-detect text files and normalize line endings
* text=auto

# Python files - use LF
*.py text eol=lf

# Config files - use LF
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf

# Windows batch files - keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
